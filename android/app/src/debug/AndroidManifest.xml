<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: merged into the debug APK, absent from release.
  Test signals the Pleos emulator cannot produce, sent from adb (app vehicle/TestSignals.kt,
  android/tools/test-signal.sh).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Only the adb shell can send to it: the shell user holds DUMP, apps do not. -->
        <receiver
            android:name=".qa.TestSignalReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.safelog.app.TEST_SIGNAL" />
            </intent-filter>
        </receiver>
        <!-- Starts the test console page with the app process (127.0.0.1:8077 on the device, through adb forward). -->
        <provider
            android:name=".qa.TestConsoleProvider"
            android:authorities="${applicationId}.qa.testconsole"
            android:exported="false" />
    </application>
</manifest>
